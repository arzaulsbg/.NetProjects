<div class="auth"><p class="eyebrow">WELCOME BACK</p><h1>Sign in</h1>@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}<form method="post"><label>Email<input name="email" type="email" required></label><label>Password<input name="password" type="password" required></label><button class="primary">Sign in</button><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /></form><p>New here? <a href="/Account/Register?returnUrl=@System.Net.WebUtility.UrlEncode((string?)ViewBag.ReturnUrl)">Create an account</a></p></div>
