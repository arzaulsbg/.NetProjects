@model MovieTicketBooking.Web.Models.RegisterVm
<div class="auth"><p class="eyebrow">CREATE ACCOUNT</p><h1>Join CineBook</h1>@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}<form method="post"><label>Full name<input name="Name" required></label><label>City<input name="City"></label><label>Email<input name="Email" type="email" required></label><label>Password<input name="Password" type="password" minlength="4" required></label><button class="primary">Create account</button><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /></form><p>Already registered? <a href="/Account/Login">Sign in</a></p></div>
