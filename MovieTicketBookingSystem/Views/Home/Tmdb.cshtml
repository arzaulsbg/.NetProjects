@model MovieTicketBooking.Web.Services.TmdbMovie
@{var localShows=(List<MovieTicketBooking.Web.Models.ShowCard>)ViewBag.LocalShows;}
<section class="tmdb-detail" style="--backdrop:url('@Model.BackdropUrl')">
  <div class="tmdb-backdrop"></div><div class="tmdb-content"><img class="tmdb-poster" src="@Model.PosterUrl" alt="@Model.Title"><div><p class="eyebrow">MOVIE DETAILS • LIVE FROM TMDB</p><h1>@Model.Title</h1><p class="tmdb-meta">⭐ @Model.VoteAverage.ToString("0.0") / 10 &nbsp; • &nbsp; @Model.Year &nbsp; • &nbsp; @(Model.Runtime > 0 ? Model.Runtime + " min" : "Runtime unavailable")</p><p class="lead">@Model.Overview</p><p class="tmdb-genres">@Model.GenresText</p><div class="detail-actions">@if(!string.IsNullOrWhiteSpace(Model.TrailerUrl)){<a class="ghost" target="_blank" rel="noopener" href="@Model.TrailerUrl">▶ Watch Trailer</a>}<a class="primary" href="#booking">🎟 Book Tickets</a></div></div></div>
</section>
<section id="booking" class="section"><div class="section-head"><div><p class="eyebrow">BOOK THIS MOVIE</p><h2>Choose your show</h2><p class="muted">Shows are automatically created for this movie in the demo cinema network.</p></div></div><div class="show-grid">@foreach(var x in localShows){<div class="show-card"><div><strong>@x.Theatre.TheatreName</strong><p>@x.Theatre.City • @x.AvailableSeats seats available</p><small>@x.Show.StartDate.ToString("ddd, dd MMM • hh:mm tt")</small></div><div class="show-right"><span>₹@x.Show.SilverSeatRate – ₹@x.Show.PlatinumSeatRate</span><a class="primary small" href="/Booking/Select?id=@x.Show.ShowID">Book now</a></div></div>}</div></section>
