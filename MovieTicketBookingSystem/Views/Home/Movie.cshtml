@model MovieTicketBooking.Web.Models.Movie
<div class="movie-detail"><img src="@Model.PosterUrl"><div><p class="eyebrow">@Model.Genre • @Model.Language</p><h1>@Model.MovieName</h1><p class="lead">@Model.Story</p><div class="facts"><b>Director<br><span>@Model.DirectorName</span></b><b>Producer<br><span>@Model.ProducerName</span></b><b>Duration<br><span>@Model.Duration.ToString("0.##") hours</span></b></div></div></div><section class="section"><p class="eyebrow">SHOWTIMES</p><h2>Choose your show</h2><div class="show-grid">@foreach(var x in (List<MovieTicketBooking.Web.Models.ShowCard>)ViewBag.Shows){<div class="show-card"><div><strong>@x.Theatre.TheatreName</strong><p>@x.Theatre.City</p><small>@x.Show.StartDate.ToString("ddd, dd MMM • hh:mm tt")</small></div><div class="show-right"><span>₹@x.Show.GoldSeatRate • @x.AvailableSeats left</span><a class="primary small" href="/Booking/Select?id=@x.Show.ShowID">Select</a></div></div>}</div></section>
