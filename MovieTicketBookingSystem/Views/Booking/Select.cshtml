@model MovieTicketBooking.Web.Models.BookingVm
<div class="booking-head"><div><p class="eyebrow">SELECT SEATS</p><h1>@Model.ShowCard.Movie.MovieName</h1><p>@Model.ShowCard.Theatre.TheatreName • @Model.ShowCard.Show.StartDate.ToString("ddd, dd MMM • hh:mm tt")</p></div></div>@if(TempData["Error"]!=null){<div class="error">@TempData["Error"]</div>}<div class="seat-layout"><div class="screen">SCREEN</div><div id="seats" class="seats" data-show="@Model.ShowCard.Show.ShowID" data-total="@Model.ShowCard.Theatre.NumberOfSeats"></div><div class="legend"><span>□ Available</span><span>■ Selected</span><span>× Booked</span></div></div><form class="checkout" method="post" action="/Booking/Confirm"><input type="hidden" name="showId" value="@Model.ShowCard.Show.ShowID"><input type="hidden" id="selectedSeats" name="selectedSeats"><label>Seat category<select id="seatType" name="seatType"><option>Silver</option><option selected>Gold</option><option>Platinum</option></select></label><div><span id="summary">0 seats</span><strong id="total">₹0</strong><button class="primary" type="submit">Confirm booking</button></div></form><script>window.booked=@Html.Raw(System.Text.Json.JsonSerializer.Serialize((List<int>)ViewBag.Occupied)); window.rates={Silver:@Model.ShowCard.Show.SilverSeatRate,Gold:@Model.ShowCard.Show.GoldSeatRate,Platinum:@Model.ShowCard.Show.PlatinumSeatRate};</script>
