@model MovieTicketBooking.Web.Models.Booking
@{var show=(MovieTicketBooking.Web.Models.Show)ViewBag.Show;var movie=(MovieTicketBooking.Web.Models.Movie)ViewBag.Movie;var theatre=(MovieTicketBooking.Web.Models.Theatre)ViewBag.Theatre;}
<div class="confirmation"><div class="ticket"><div class="check">✓</div><p class="eyebrow">BOOKING CONFIRMED</p><h1>You're going to @movie.MovieName</h1><p>@theatre.TheatreName • @show.StartDate.ToString("dddd, dd MMMM yyyy • hh:mm tt")</p><div class="ticket-grid"><div><small>BOOKING ID</small><b>#@Model.BookingID</b></div><div><small>SEATS</small><b>@string.Join(", ",Model.SeatNumbers)</b></div><div><small>CLASS</small><b>@Model.SeatType</b></div><div><small>TOTAL</small><b>₹@Model.Amount</b></div></div><a class="primary" href="/Booking/Mine">View my bookings</a></div></div>
