<div class="section"><p class="eyebrow">ACCOUNT</p><h1>My bookings</h1>@if(!((IEnumerable<MovieTicketBooking.Web.Models.Booking>)ViewBag.Bookings).Any()){<div class="empty">No bookings yet. <a href="/">Explore movies</a></div>}else{<div class="booking-list">@foreach(var b in (IEnumerable<MovieTicketBooking.Web.Models.Booking>)ViewBag.Bookings){<div class="booking-row"><div><b>#@b.BookingID</b><strong>@b.CustomerName</strong><small>@b.BookingDate.ToString("dd MMM yyyy, hh:mm tt")</small></div><div><span>@b.SeatType • Seats @string.Join(", ",b.SeatNumbers)</span><b>₹@b.Amount</b></div><div><span class="status @b.BookingStatus.ToLower()">@b.BookingStatus</span>@if(b.BookingStatus=="Confirmed"){<form method="post" action="/Booking/Cancel"><input type="hidden" name="id" value="@b.BookingID"><button class="linkdanger">Cancel</button></form>}</div></div>}}</div>}</div>
