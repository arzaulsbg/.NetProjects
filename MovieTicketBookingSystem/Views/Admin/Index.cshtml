@{var movies=(List<MovieTicketBooking.Web.Models.Movie>)ViewBag.Movies;var theatres=(List<MovieTicketBooking.Web.Models.Theatre>)ViewBag.Theatres;var shows=(List<MovieTicketBooking.Web.Models.Show>)ViewBag.Shows;var bookings=(List<MovieTicketBooking.Web.Models.Booking>)ViewBag.Bookings;}
<div class="admin-head"><div><p class="eyebrow">CONTROL CENTER</p><h1>Admin dashboard</h1></div><a href="/Admin/Logout">Logout</a></div><div class="stats"><div><b>@movies.Count</b><span>Movies</span></div><div><b>@theatres.Count</b><span>Theatres</span></div><div><b>@shows.Count</b><span>Shows</span></div><div><b>@bookings.Count</b><span>Bookings</span></div></div><div class="admin-grid"><section class="panel"><h2>Add movie</h2><form method="post" action="/Admin/AddMovie"><input name="MovieName" placeholder="Movie name" required><input name="DirectorName" placeholder="Director"><input name="ProducerName" placeholder="Producer"><input name="Duration" type="number" step="0.1" placeholder="Duration (hours)"><input name="Genre" placeholder="Genre"><input name="Language" placeholder="Language"><input name="PosterUrl" placeholder="Poster image URL"><textarea name="Story" placeholder="Story"></textarea><button class="primary">Add movie</button></form></section><section class="panel"><h2>Add theatre</h2><form method="post" action="/Admin/AddTheatre"><input name="TheatreName" placeholder="Theatre name" required><input name="City" placeholder="City"><input name="NumberOfSeats" type="number" placeholder="Seats" required><button class="primary">Add theatre</button></form><h2 class="mt">Add show</h2><form method="post" action="/Admin/AddShow"><select name="MovieID">@foreach(var m in movies){<option value="@m.MovieID">@m.MovieName</option>}</select><select name="TheatreID">@foreach(var t in theatres){<option value="@t.TheatreID">@t.TheatreName</option>}</select><input name="StartDate" type="datetime-local" required><input name="EndDate" type="datetime-local" required><input name="PlatinumSeatRate" type="number" placeholder="Platinum ₹" required><input name="GoldSeatRate" type="number" placeholder="Gold ₹" required><input name="SilverSeatRate" type="number" placeholder="Silver ₹" required><button class="primary">Create show</button></form></section></div><section class="panel tablepanel"><h2>Recent bookings</h2><table><tr><th>ID</th><th>Customer</th><th>Seats</th><th>Amount</th><th>Status</th><th></th></tr>@foreach(var b in bookings.OrderByDescending(x=>x.BookingDate).Take(20)){<tr><td>#@b.BookingID</td><td>@b.CustomerName</td><td>@string.Join(", ",b.SeatNumbers)</td><td>₹@b.Amount</td><td>@b.BookingStatus</td><td>@if(b.BookingStatus=="Confirmed"){<form method="post" action="/Admin/CancelBooking"><input type="hidden" name="id" value="@b.BookingID"><button class="linkdanger">Cancel</button></form>}</td></tr>}</table></section>
